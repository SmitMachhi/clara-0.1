# Environment Configuration
# Copy this file to .env for local development

# Development mode: Disable 2pm time cutoff for journal access
# Set to 'true' to allow journal access at any time during development
# Remove or set to 'false' for production behavior
VITE_DISABLE_TIME_CUTOFF=true

JOURNAL_PASSPHRASE=dev-passphrase
JOURNAL_ENCRYPTION_KEY=dev-encryption-key-change-in-prod
JOURNAL_SESSION_SECRET=dev-session-secret-change-in-prod
