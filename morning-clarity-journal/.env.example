# Environment Configuration
# Copy this file to .env for local development

# Development mode: Disable 2pm time cutoff for journal access
# Set to 'true' to allow journal access at any time during development
# Remove or set to 'false' for production behavior
VITE_DISABLE_TIME_CUTOFF=true

# API Bearer Token: protects /api/* routes from unauthorized access
# Generate a random 32+ character string for production
# On Fly.io, set via: fly secrets set PUBLIC_API_TOKEN=<random-value>
PUBLIC_API_TOKEN=dev-mcj-token-2026
